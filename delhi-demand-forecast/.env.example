# Copy to .env and adjust. All backend variables are prefixed PEAKWATCH_.
# No secrets are required: Open-Meteo needs no API key.

# Grid capacity PLANNING ASSUMPTION used for risk levels (MW), not a measured limit.
# 9,200 = published record peak 8,748 MW (29 June 2026) x 1.05 reserve, rounded. See backend/config.py.
PEAKWATCH_CAPACITY_MW=9200

# Cleaned real dataset. Leave unset (or point at a missing file) to run in DEMO MODE.
# PEAKWATCH_HISTORY_CSV=data/processed/delhi_history.csv

# Trained model artifacts. model.joblib is used only with a real dataset.
PEAKWATCH_MODEL_PATH=ml/models/model.joblib
PEAKWATCH_DEMO_MODEL_PATH=ml/models/demo_model.joblib

# Train a demo model in the background at startup when none exists (DEMO MODE only).
PEAKWATCH_AUTO_TRAIN_DEMO=true
PEAKWATCH_DEMO_HISTORY_DAYS=730

# Open-Meteo weather forecast (live -> cache -> demo fallback).
PEAKWATCH_WEATHER_ENABLED=true
PEAKWATCH_WEATHER_TIMEOUT_S=8
PEAKWATCH_WEATHER_CACHE_TTL_MIN=180

# Freeze the clock for reproducible demos (ISO 8601). Empty = wall clock.
# PEAKWATCH_FIXED_NOW=2026-09-04T10:00:00+05:30

PEAKWATCH_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Frontend (Vite reads VITE_* from frontend/.env)
VITE_API_URL=http://localhost:8000
