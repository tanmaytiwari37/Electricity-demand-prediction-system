{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "installCommand": "cd delhi-demand-forecast/frontend && npm install",
  "buildCommand": "cd delhi-demand-forecast/frontend && npm run build",
  "outputDirectory": "delhi-demand-forecast/frontend/dist",
  "rewrites": [
    { "source": "/api/:path*", "destination": "https://peakwatch-api.onrender.com/api/:path*" },
    { "source": "/((?!api/).*)", "destination": "/index.html" }
  ]
}
